# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/cinetrack

# ── Auth Secrets (CHANGE THESE IN PRODUCTION) ─
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_me_to_another_random_64_char_string

# ── TMDb API ──────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
USE_MOCK=false

# ── CORS — comma-separated allowed origins ────
CLIENT_URLS=http://localhost:5173

# ── Admin Seed (REQUIRED — no defaults) ───────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ── Phase 3: Redis & Sentry (uncomment when ready)
# REDIS_URL=redis://127.0.0.1:6379
# SENTRY_DSN=
